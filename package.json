{
  "name": "duality",
  "private": true,
  "version": "1.0.0",
  "description": "DUALITY \u2014 a cooperative online 2D physics-puzzle platformer for two players.",
  "type": "module",
  "workspaces": [
    "packages/shared",
    "apps/server",
    "apps/web"
  ],
  "scripts": {
    "dev": "node tools/dev.mjs",
    "dev:server": "npm run dev -w apps/server",
    "dev:web": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web && npm run build -w apps/server",
    "start": "node apps/server/dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p packages/shared && tsc -p apps/server --noEmit && tsc -p apps/web --noEmit",
    "validate-levels": "tsx tools/validate-levels.ts",
    "e2e": "node tests/e2e/run.mjs",
    "art:placeholders": "node tools/art/make-placeholders.mjs",
    "asset-audit": "node tools/asset-audit.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "playwright-core": "1.64.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "3.2.7"
  }
}
